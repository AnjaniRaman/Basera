{
  "name": "basera",
  "version": "2.0.0",
  "private": true,
  "description": "Basera: PG and hostel management for owners, residents and staff in one app (web, Android, iOS, Windows)",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend",
    "start": "npm start --workspace backend",
    "test": "npm test --workspace shared && npm test --workspace backend",
    "test:e2e": "node tests/e2e.mjs",
    "check:locales": "node frontend/scripts/check-locales.mjs",
    "lint": "npm run lint --workspace frontend",
    "preview:build": "node scripts/make-preview.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
