{
  "name": "@basera/app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Basera web app: owner console, resident portal and staff portal (also packaged for Android, iOS and Windows)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "check:locales": "node scripts/check-locales.mjs",
    "brand": "node scripts/make-brand-assets.mjs && npx capacitor-assets generate --iconBackgroundColor '#0E6B55' --iconBackgroundColorDark '#0E6B55' --splashBackgroundColor '#F5F6F4' --splashBackgroundColorDark '#0F1519'",
    "cap:sync": "cap sync"
  },
  "dependencies": {
    "@basera/domain": "*",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.3"
  }
}
