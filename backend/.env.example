# Copy to backend/.env (never commit the real file).

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated origins allowed to call the API from a browser, or * for any.
CORS_ORIGIN=*
# Set to 1 behind Render/Railway/nginx so rate limits see the real client IP.
TRUST_PROXY=0
# Serve frontend/dist from the same server (one deployment for API + web app).
SERVE_FRONTEND=1

# Database: leave DATABASE_URL empty to use the embedded PGlite database in DATA_DIR.
DATABASE_URL=
DATA_DIR=./data/pglite

# Sessions
SESSION_DAYS=90

# One-time codes. console = print to the server log (development only).
OTP_PROVIDER=console
# A fixed code accepted in development (ignored in production unless ALLOW_DEV_OTP=1 — do not do that live).
AUTH_DEV_OTP=123456
# ALLOW_DEV_OTP=0

# MSG91 (OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=

# Twilio (OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Your own SMS gateway (OTP_PROVIDER=webhook): receives JSON {phone, code, app} with X-OTP-Secret.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=

# Uploads (ID proofs, agreements), bytes per file.
MAX_UPLOAD_BYTES=5242880
APP_NAME=Basera
